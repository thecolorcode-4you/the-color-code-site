{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers & Pages).
  "name": "the-color-code-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API requests run our code; every page is served straight from /public.
    "run_worker_first": ["/api/*"]
  },
  // No ID needed: Wrangler creates the database on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "the-color-code-db" }
  ],
  // Caps photo analyses per visitor, since each one is a paid call to Claude.
  "ratelimits": [
    { "name": "ANALYZE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // ANTHROPIC_API_KEY is a secret set in the Cloudflare dashboard, never in this file.
  "observability": { "enabled": true }
}
